    {"type": "text", "id": "title", "x": 340, "y": 20, "text": "VENUS 主程序工作流程（VENUS.f90）", "fontSize": 28, "fontFamily": 1, "strokeColor": "#1e1e1e", "originalText": "VENUS 主程序工作流程（VENUS.f90）", "autoResize": true},

