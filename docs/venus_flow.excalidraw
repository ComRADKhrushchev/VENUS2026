    {"type": "text", "id": "t_endstat", "x": 250, "y": 1735, "text": "全局统计输出\n截面/反应概率（NON-REACTIVE/REACTIVE 计数）\nfort.999 + stdout 汇总", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "endstat", "originalText": "全局统计输出\n截面/反应概率（NON-REACTIVE/REACTIVE 计数）\nfort.999 + stdout 汇总", "autoResize": true},

