    {"type": "text", "id": "t_start", "x": 340, "y": 90, "text": "程序启动", "fontSize": 20, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "start", "originalText": "程序启动", "autoResize": true},

    {"type": "rectangle", "id": "input", "x": 260, "y": 170, "width": 400, "height": 80, "roundness": {"type": 3}, "backgroundColor": "#a5d8ff", "fillStyle": "solid", "boundElements": [{"id": "t_input", "type": "text"}]},
    {"type": "text", "id": "t_input", "x": 270, "y": 182, "text": "venus_input（读 input_qct.txt）\n关键字解析 → 参数/预设 → 初始几何\n:479 调 POTPRE（PES 初始化）", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "input", "originalText": "venus_input（读 input_qct.txt）\n关键字解析 → 参数/预设 → 初始几何\n:479 调 POTPRE（PES 初始化）", "autoResize": true},

    {"type": "diamond", "id": "chkp", "x": 300, "y": 290, "width": 320, "height": 110, "backgroundColor": "#fff3bf", "fillStyle": "solid", "boundElements": [{"id": "t_chkp", "type": "text"}]},
    {"type": "text", "id": "t_chkp", "x": 330, "y": 325, "text": "NCHKP / NSELT 分派\n（checkpoint 重启 / 读入 Q/P？）", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "chkp", "originalText": "NCHKP / NSELT 分派\n（checkpoint 重启 / 读入 Q/P？）", "autoResize": true},

    {"type": "rectangle", "id": "randst", "x": 700, "y": 300, "width": 280, "height": 70, "roundness": {"type": 3}, "backgroundColor": "#d0bfff", "fillStyle": "solid", "boundElements": [{"id": "t_randst", "type": "text"}]},
    {"type": "text", "id": "t_randst", "x": 710, "y": 315, "text": "RANDST(ISEED)\n随机数初始化（:184/:231）", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "randst", "originalText": "RANDST(ISEED)\n随机数初始化（:184/:231）", "autoResize": true},

    {"type": "rectangle", "id": "trajloop", "x": 300, "y": 450, "width": 320, "height": 80, "roundness": {"type": 3}, "backgroundColor": "#d0bfff", "fillStyle": "solid", "boundElements": [{"id": "t_trajloop", "type": "text"}]},
    {"type": "text", "id": "t_trajloop", "x": 310, "y": 465, "text": "轨迹循环 NTZ = 1..NT\n（每条轨迹）", "fontSize": 20, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "trajloop", "originalText": "轨迹循环 NTZ = 1..NT\n（每条轨迹）", "autoResize": true},

    {"type": "rectangle", "id": "select", "x": 240, "y": 580, "width": 440, "height": 100, "roundness": {"type": 3}, "backgroundColor": "#a5d8ff", "fillStyle": "solid", "boundElements": [{"id": "t_select", "type": "text"}]},
    {"type": "text", "id": "t_select", "x": 250, "y": 592, "text": "SELECT（:347）初条件总分派\nNACTA/NACTB → INITEBK / INITQP / ORTHAN /\nBAREXC / THRMAN / QMMICRO / SURF / MB …", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "select", "originalText": "SELECT（:347）初条件总分派\nNACTA/NACTB → INITEBK / INITQP / ORTHAN /\nBAREXC / THRMAN / QMMICRO / SURF / MB …", "autoResize": true},

    {"type": "rectangle", "id": "init_e", "x": 740, "y": 590, "width": 300, "height": 80, "roundness": {"type": 3}, "backgroundColor": "#c3fae8", "fillStyle": "solid", "boundElements": [{"id": "t_init_e", "type": "text"}]},
    {"type": "text", "id": "t_init_e", "x": 750, "y": 605, "text": "ENERGY_1 / DVDQ_1（:400-401）\n初势能与梯度（调 POT0/DPESHON）", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "init_e", "originalText": "ENERGY_1 / DVDQ_1（:400-401）\n初势能与梯度（调 POT0/DPESHON）", "autoResize": true},

    {"type": "rectangle", "id": "gwrite0", "x": 740, "y": 700, "width": 300, "height": 70, "roundness": {"type": 3}, "backgroundColor": "#b2f2bb", "fillStyle": "solid", "boundElements": [{"id": "t_gwrite0", "type": "text"}]},
    {"type": "text", "id": "t_gwrite0", "x": 750, "y": 715, "text": "GWRITE（:403）\nstep-0 相空间写出 fort.1NNN", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "gwrite0", "originalText": "GWRITE（:403）\nstep-0 相空间写出 fort.1NNN", "autoResize": true},

    {"type": "rectangle", "id": "intloop", "x": 300, "y": 730, "width": 320, "height": 80, "roundness": {"type": 3}, "backgroundColor": "#d0bfff", "fillStyle": "solid", "boundElements": [{"id": "t_intloop", "type": "text"}]},
    {"type": "text", "id": "t_intloop", "x": 310, "y": 745, "text": "积分循环 NC = 1..NS\n（每动力学步）", "fontSize": 20, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "intloop", "originalText": "积分循环 NC = 1..NS\n（每动力学步）", "autoResize": true},

    {"type": "diamond", "id": "intsel", "x": 290, "y": 860, "width": 340, "height": 130, "backgroundColor": "#fff3bf", "fillStyle": "solid", "boundElements": [{"id": "t_intsel", "type": "text"}]},
    {"type": "text", "id": "t_intsel", "x": 300, "y": 895, "text": "INTEGRATOR 分派\n1=RADAU（:431/:444）\n2=SYMPLE（:447）\n3=VERLET/BEEMAN（:453）", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "intsel", "originalText": "INTEGRATOR 分派\n1=RADAU（:431/:444）\n2=SYMPLE（:447）\n3=VERLET/BEEMAN（:453）", "autoResize": true},

    {"type": "rectangle", "id": "pes", "x": 700, "y": 880, "width": 340, "height": 90, "roundness": {"type": 3}, "backgroundColor": "#c3fae8", "fillStyle": "solid", "boundElements": [{"id": "t_pes", "type": "text"}]},
    {"type": "text", "id": "t_pes", "x": 710, "y": 892, "text": "DVDQ_1（积分器内每步调用）\n→ PES 的 DPESHON（梯度）\nTEST_PES: HARMONIC/MORSE/LEPS/RST", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "pes", "originalText": "DVDQ_1（积分器内每步调用）\n→ PES 的 DPESHON（梯度）\nTEST_PES: HARMONIC/MORSE/LEPS/RST", "autoResize": true},

    {"type": "rectangle", "id": "test", "x": 290, "y": 1060, "width": 340, "height": 80, "roundness": {"type": 3}, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "boundElements": [{"id": "t_test", "type": "text"}]},
    {"type": "text", "id": "t_test", "x": 300, "y": 1075, "text": "TEST（:577）事件检测\n散射/反应判据 → NTEST", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "test", "originalText": "TEST（:577）事件检测\n散射/反应判据 → NTEST", "autoResize": true},

    {"type": "rectangle", "id": "gwrite", "x": 700, "y": 1060, "width": 340, "height": 80, "roundness": {"type": 3}, "backgroundColor": "#b2f2bb", "fillStyle": "solid", "boundElements": [{"id": "t_gwrite", "type": "text"}]},
    {"type": "text", "id": "t_gwrite", "x": 710, "y": 1075, "text": "GWRITE（每 NIP 步，:448/:457）\nfort.1NNN 相空间逐步写出", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "gwrite", "originalText": "GWRITE（每 NIP 步，:448/:457）\nfort.1NNN 相空间逐步写出", "autoResize": true},

    {"type": "diamond", "id": "done", "x": 300, "y": 1200, "width": 320, "height": 120, "backgroundColor": "#fff3bf", "fillStyle": "solid", "boundElements": [{"id": "t_done", "type": "text"}]},
    {"type": "text", "id": "t_done", "x": 310, "y": 1235, "text": "轨迹终止？\nNTEST=2（散射/反应完成）\n或 NC=NS（跑满）", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "done", "originalText": "轨迹终止？\nNTEST=2（散射/反应完成）\n或 NC=NS（跑满）", "autoResize": true},

    {"type": "rectangle", "id": "final", "x": 240, "y": 1390, "width": 440, "height": 100, "roundness": {"type": 3}, "backgroundColor": "#b2f2bb", "fillStyle": "solid", "boundElements": [{"id": "t_final", "type": "text"}]},
    {"type": "text", "id": "t_final", "x": 250, "y": 1402, "text": "终态分析：FINAL（:506/:594 产物能量/散射角）\n+ GFINAL（:541/:628 统计汇总 fort.999）\n+ POT0 终势能（:547/:634）", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "final", "originalText": "终态分析：FINAL（:506/:594 产物能量/散射角）\n+ GFINAL（:541/:628 统计汇总 fort.999）\n+ POT0 终势能（:547/:634）", "autoResize": true},

    {"type": "diamond", "id": "next", "x": 300, "y": 1540, "width": 320, "height": 110, "backgroundColor": "#fff3bf", "fillStyle": "solid", "boundElements": [{"id": "t_next", "type": "text"}]},
    {"type": "text", "id": "t_next", "x": 310, "y": 1572, "text": "NTZ < NT？\n（还有轨迹）", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "next", "originalText": "NTZ < NT？\n（还有轨迹）", "autoResize": true},

