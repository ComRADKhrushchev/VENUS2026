#!/bin/bash
#SBATCH -J m160_ens
#SBATCH -p mars_l
#SBATCH -N 1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH -t 16:00:00
#SBATCH -o m160.log
cd "$SLURM_SUBMIT_DIR"
AWKPROG='/^# frame/{ match($0,/traj=[0-9]+/); nt=substr($0,RSTART+5,RLENGTH-5)+0; match($0,/t= *[0-9.E+-]+/); tt=substr($0,RSTART+2,RLENGTH-2)+0; if(nt!=ct && ct>0) printf "%d %.4f %.6f %.6f %.6f %.6f %.6f\n", ct, ctk, cqx, cqy, cp1, cp2, cp3; ct=nt; ctk=tt } /^1 C /{ cp1=$6+0; cp2=$7+0; cp3=$8+0; cqx=$3+0; cqy=$4+0 } END{ printf "%d %.4f %.6f %.6f %.6f %.6f %.6f\n", ct, ctk, cqx, cqy, cp1, cp2, cp3 }'
DIRS=$(ls -d m160_runs/*/ | sort)
N=$(echo "$DIRS" | wc -l)
i=0
for d in $DIRS; do
  leg=$(basename "$d")
  ( cd "$d" && ../../src/build/gfortran/venus.e > stdout_run.txt 2>&1 )
  awk "$AWKPROG" "$d/trajectories.txt" > "m160_${leg}_fin.txt"
  cp "$d/hist_thta.dat" "m160_${leg}_thta.dat" 2>/dev/null
  cp "$d/hist_e_rel.dat" "m160_${leg}_erel.dat" 2>/dev/null
  rm -f "$d/trajectories.txt"
  i=$((i+1))
  echo "$leg ($i/$N) rows: $(wc -l < m160_${leg}_fin.txt)"
done
echo M160_DONE > m160_done.flag
