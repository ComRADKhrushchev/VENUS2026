#!/bin/bash
#SBATCH -J r8v
#SBATCH -p mars_l
#SBATCH -N 1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH -t 3:00:00
#SBATCH -o r8v_%a.log
#SBATCH --array=0-1
cd "$SLURM_SUBMIT_DIR"
AWKPROG='/^# frame/{ match($0,/traj=[0-9]+/); nt=substr($0,RSTART+5,RLENGTH-5)+0; if(nt!=ct && ct>0) printf "%d %.3f %.4f %.4f\n", ct, ctk, ce0, cet; if(ct!=nt){ct=nt; seen0=0} } /^t_kin=/{ match($0,/e_tot= *[0-9.E+-]+/); v=substr($0,RSTART+6,RLENGTH-6)+0; cet=v; if(seen0==0){ce0=v; seen0=1} } END{ if(ct>0) printf "%d %.3f %.4f %.4f\n", ct, ctk, ce0, cet }'
d=$(ls -d r8v_runs/*/ | sort | sed -n "$((SLURM_ARRAY_TASK_ID+1))p")
leg=$(basename "$d")
cd "$d"
../../src/build/gfortran/venus.e > stdout_run.txt 2>&1
awk "$AWKPROG" trajectories.txt > "../../r8v_${leg}_drift.txt"
if [ -s "../../r8v_${leg}_drift.txt" ]; then rm -f trajectories.txt; else cp trajectories.txt trajectories.keep; fi
echo DONE > "../../r8v_${leg}.done"
