#!/bin/bash
#SBATCH -J cautab_cell
#SBATCH -p mars_l
#SBATCH -N 1
#SBATCH --ntasks=1
#SBATCH -t 02:00:00
#SBATCH -o cell.log
cd "$SLURM_SUBMIT_DIR"
AWKPROG='/^# frame/{ match($0,/traj=[0-9]+/); nt=substr($0,RSTART+5,RLENGTH-5)+0; match($0,/t= *[0-9.E+-]+/); tt=substr($0,RSTART+2,RLENGTH-2)+0; if(nt!=ct && ct>0) printf "%d %.4f %.6f %.6f %.6f %.6f %.6f
", ct, ctk, cqx, cqy, cp1, cp2, cp3; ct=nt; ctk=tt } /^1 C /{ cp1=$6+0; cp2=$7+0; cp3=$8+0; cqx=$3+0; cqy=$4+0 } END{ printf "%d %.4f %.6f %.6f %.6f %.6f %.6f
", ct, ctk, cqx, cqy, cp1, cp2, cp3 }'
for leg in E1D_rst E3P_rst E1D_cur E3P_cur; do
  ( cd "cellruns/$leg" && ../../src/build/gfortran/venus.e > stdout_run.txt 2>&1 )
  awk "$AWKPROG" "cellruns/$leg/trajectories.txt" > "${leg}_cell_fin.txt"
  rm -f "cellruns/$leg/trajectories.txt"
  echo "$leg rows: $(wc -l < ${leg}_cell_fin.txt)"
done
echo CELL_DONE > cell_done.flag
