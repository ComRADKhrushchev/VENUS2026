!
!   This SIZES file is for nactb equal to 7
!     i.e. for md selection of surface temperature
!
!***********************************************************************
!     VENUS dimensions
!
!     NDA      maximum number of atoms
!     NDA3     total number of degrees of freedom (NDA*3)
!  For nact=7 (md selection for temperature) NDA3=natoma*3
!     NDAyf     maximum number of atoms in fragment A
!     NDA3yf   nacta=7: 3*NDAyf, otherwise 3*NDA
!  This distinction is made in SIZESvg and SIZESmd, so choose appropriate one.
!     NDP      number of reaction paths
!     NDG      number of angles to be calculated in FINAL
!
!CApbc------------------
!       parameters for ewald summation
!       maxk    max total number of k vectors
!
      PARAMETER (maxk=50000)
!CA---------------
      PARAMETER(NDA=160,NDA3=NDA*3,NDP=10,NDG=20)
      PARAMETER(NDAyf=30,NDA3yf=NDAyf*3)
!
!     ND01    number of harmonic stretches
!     ND02    number of morse stretches
!     ND03    number of harmonic bends
!     ND04    number of harmonic wags
!     ND05    number of Lennard-Jones terms
!     ND06    number of torsions
!     ND07    number of generalized expotential repulsion and attraction
!                       potential functions
!     ND08    number of ghost pair interactions
!     ND09    number of tetrahedral centers
!     ND10    number of R-R couplings
!     ND11    number of R-THETA couplings
!     ND12    number of THETA-THETA couplings
!     ND13I   number of dihedral angles
!     ND13J   number of terms in the dihedral potential energy 
!
!     ND21    number of sp2/sp3 relaxation for a H + diamond interaction
!     ND22    number of H---H non-bonded interactions
!
      PARAMETER(ND01=6000,ND02=12000,ND03=10000,ND04=20,ND05=200000)
      PARAMETER(ND06=20,ND07=2000000,ND08=20,ND09=20)
      PARAMETER(ND10=500, ND11=1200, ND12=1200) 
      PARAMETER(ND13I=4000,ND13J=12) 
      PARAMETER(ND21=2,ND22=100)
!
!     NCF  number of maximum integration points for Gauss-Legendre Quadrature
!
      PARAMETER(NCF=300)
!
!     NDIHE   number of hessians from Gaussian
!             should not be less than NDA3*(NDA3+1)/2+2*NDA3,
!             where NDA3=3*number of atoms
!
      PARAMETER(NDIHE=NDA3yf*(NDA3yf+1)/2+2*NDA3yf)
!
!     The followings are for the ebk quantizations
!     ne: number of energies to do the action integral
!     mxlvl: maximum number of energy levels for partition function
!
      parameter(ne=300,mxlvl=600)
!
!     The followings are used for direct dynamics calculation using
!     gaussian 99 version b8+ as the trajectory integrator.
!     mxpth      maximum number of reaction path
!     mxdiatom   maximum number of diatomic products
!
      parameter(mxpth=10,mxdiatom=5)
!
!     some energy conversion parameters
!     cal2cm: kcal/mol to cm-1
!     cm2cal: cm-1 to kcal/mol
!
!      parameter(cal2cm=349.755,cm2cal=1.0/cal2cm)

